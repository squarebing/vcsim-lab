# Copy to .env and adjust (the scripts read these from the environment).
# vcsim defaults accept any username/password; the compose file pins
# these two, so keep them in sync with VCSIM_USERNAME/VCSIM_PASSWORD.
VC_HOST=127.0.0.1
VC_PORT=8989
VC_USER=user
VC_PASSWORD=pass
# 1 = skip TLS verification (vcsim's cert is self-signed). Use 0 against a
# real vCenter with a trusted certificate.
VC_INSECURE=1
# URL scheme for the SDK endpoint: https by default (vcsim serves TLS).
# Set to http when vcsim runs with -tls=false — the container on Render,
# where TLS is terminated at the edge and plain HTTP is forwarded.
VC_SCHEME=https

VCSIM_USERNAME=user
VCSIM_PASSWORD=pass
# govmomi release used by tools/start-vcsim-binary.sh
VCSIM_VERSION=v0.56.2

# Inventory API (scripts/serve_api.py): listen address and port.
# The API is the front door — it serves /api/* and reverse-proxies
# everything else (/sdk, /about) to vcsim at VC_HOST:VC_PORT.
# API_PORT falls back to $PORT (Render injects it), then 8000.
# API_HOST defaults to 127.0.0.1; the container uses 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000
