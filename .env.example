# Copy to .env and adjust (the scripts read these from the environment).
# vcsim defaults accept any username/password; the compose file pins
# these two, so keep them in sync with VCSIM_USERNAME/VCSIM_PASSWORD.
VC_HOST=127.0.0.1
VC_PORT=8989
VC_USER=user
VC_PASSWORD=pass
# 1 = skip TLS verification (vcsim's cert is self-signed). Use 0 against a
# real vCenter with a trusted certificate.
VC_INSECURE=1

VCSIM_USERNAME=user
VCSIM_PASSWORD=pass
# govmomi release used by tools/start-vcsim-binary.sh
VCSIM_VERSION=v0.56.2
